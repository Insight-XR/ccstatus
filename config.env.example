# Copy to config.env and edit. Every value below is a default, so an empty
# config.env is valid: you get local sessions only, auto-detected terminal.

# Extra machines to poll, comma separated. These must be ssh host aliases that
# work non-interactively (key auth, no password prompt). Leave empty for
# local-only. Each host needs: remote/install-remote.sh <host>
export CCSTATUS_HOSTS=

# Where install-remote.sh puts collect.py on those machines. Keep the quotes: the ~ must
# stay literal so the REMOTE shell expands it, not your laptop's.
export CCSTATUS_REMOTE_DIR='~/.ccstatus'

# Terminal adapter: auto | iterm2 | apple-terminal | wezterm | kitty | ghostty | generic | fallback
export CCSTATUS_TERMINAL=auto

# generic adapter only: the terminal to launch, if auto-detection picks wrong.
# export CCSTATUS_TERM_CMD=alacritty

# Model used to split idle sessions into "needs you" vs "done".
# Set CCSTATUS_CLASSIFY=0 to turn this off entirely and spend no tokens:
# you still get WORKING / SHELL / IDLE / STALE, just no NEEDS_YOU split.
export CCSTATUS_CLASSIFY=1
export CCSTATUS_MODEL=haiku

# Stall hours that fill the bar, and the age past which a session is STALE.
export CCSTATUS_FULL_BAR_HOURS=4
export CCSTATUS_STALE_HOURS=48

# Override if `claude` is not on PATH for GUI apps.
# export CCSTATUS_CLAUDE_BIN=/opt/homebrew/bin/claude

# How a remote session is resumed. %h=host %n=session name %s=session id.
# export CCSTATUS_REMOTE_RESUME='ssh -t %h "tmux attach -t %n 2>/dev/null || claude --resume %s"'
